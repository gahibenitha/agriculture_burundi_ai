      Q4 — Traitement des valeurs manquantes
      df2 = df.copy()

# pluviometrie_mm : médiane par groupe (province + culture)
df2['pluviometrie_mm'] = df2.groupby(['province','culture'])['pluviometrie_mm'] \
    .transform(lambda x: x.fillna(x.median()))
df2['pluviometrie_mm'].fillna(df2['pluviometrie_mm'].median(), inplace=True)

# utilisation_engrais : mode par culture
df2['utilisation_engrais'] = df2.groupby('culture')['utilisation_engrais'] \
    .transform(lambda x: x.fillna(x.mode()[0] if len(x.mode()) > 0 else 0))

# bonne_recolte + rendement + production : suppression (variable cible)
df2.dropna(subset=['bonne_recolte','rendement_t_ha','production_totale_t'],
           inplace=True)
df2 = df2.reset_index(drop=True)

print(f"Lignes restantes : {len(df2)}")
print(f"Valeurs manquantes : {df2.isnull().sum().sum()}")

